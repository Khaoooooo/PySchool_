<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple">

    <!-- วงกลมตกแต่งมุมซ้ายบน -->

    <!-- วงกลมตกแต่งมุมขวาล่าง -->

    <View
        android:id="@+id/view2"
        android:layout_width="262dp"
        android:layout_height="148dp"
        android:layout_marginStart="-110dp"
        android:layout_marginTop="-55dp"
        android:background="@drawable/bg_splash_circle"
        android:rotation="-30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="220dp"
        android:layout_height="150dp"
        android:layout_marginEnd="-120dp"
        android:layout_marginBottom="-60dp"
        android:background="@drawable/bg_splash_circle"
        android:rotation="-30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ดาวดวงบน (ปรับหลบโลโก้ใหญ่) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rotation="15"
        android:shadowColor="@color/ink"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="0.5"
        android:text="★"
        android:textColor="@color/yellow"
        android:textSize="33sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.85"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.08"
        tools:ignore="HardcodedText" />

    <!-- ดาวดวงล่าง -->

    <!-- 1. โลโก้ขยายใหญ่จริง เต็มตา (ปรับใช้สัดส่วน 0.35 ของความสูงจอ ไม่โดนบีบแน่นอน) -->

    <!-- 2. ชื่อแอป (ลบตัวบีบ letterSpacing ออก และเพิ่มขนาดให้อ่านง่ายขึ้น) -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rotation="-10"
        android:shadowColor="@color/ink"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="0.5"
        android:text="★"
        android:textColor="@color/yellow"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.131"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.858"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="391dp"
        android:layout_height="220dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_see"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2"
        app:layout_constraintVertical_bias="0.167" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/montserrat_extrabold"
        android:letterSpacing="0.02"
        android:text="@string/app_name"
        android:textColor="@color/ink"
        android:textSize="44sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintBottom_toTopOf="@id/subtitle"
        app:layout_constraintVertical_bias="0.0" />

    <!-- 3. สโลแกน (เพิ่มระยะห่างระหว่างบรรทัดและตัวอักษร ไม่เบียดกันเป็นก้อน) -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/montserrat_extrabold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:letterSpacing="0.04"
        android:text="@string/tagline_two_lines"
        android:textColor="@color/ink"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <!-- จุดโหลด 3 จุด -->
    <LinearLayout
        android:id="@+id/loadingDots"
        android:layout_width="41dp"
        android:layout_height="12dp"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot_ink" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_ink" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_ink" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
