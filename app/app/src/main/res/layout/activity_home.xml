<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Hero ===== -->
            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:background="@drawable/bg_hero"
                android:clipToOutline="true"
                android:clipToPadding="false"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp">

                <!-- ดาวมุมขวาบน -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Top Bar: Logo & Profile -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/app_name"
                            android:scaleType="fitStart"
                            android:src="@drawable/logo_see" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="5dp"
                            android:layout_weight="1" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/profileButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/cd_about"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/ink"
                            app:strokeWidth="2dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_user"
                                app:tint="@color/ink" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        style="@style/Text.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/home_journey_eyebrow" />

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:letterSpacing="-0.04"
                        android:lineSpacingMultiplier="0.95"
                        android:textColor="@color/ink"
                        android:textSize="35sp"
                        tools:text="From first line\nto real ideas." />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="75dp"
                    android:layout_marginEnd="16dp"
                    android:rotation="12"
                    android:shadowColor="@color/ink"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="0.5"
                    android:text="★"
                    android:textColor="@color/yellow"
                    android:textSize="26sp"
                    tools:ignore="HardcodedText" />

                <!-- โน้ตเหลืองโค้ด print("Hello!") -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="145dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-20dp"
                    android:layout_marginBottom="13dp"
                    android:rotation="-6"
                    app:cardBackgroundColor="@color/yellow_pale"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/ink"
                    app:strokeWidth="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono_bold"
                        android:paddingStart="15dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:text="print(&quot;Hello!&quot;)_"
                        android:textColor="@color/ink"
                        android:textSize="12sp" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- ===== Content ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Progress card วางต่อจาก hero -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/ink"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.Eyebrow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_progress_label"
                                    android:textColor="@color/purple" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="@string/home_level"
                                    android:textColor="@color/white"
                                    android:textSize="17sp" />
                            </LinearLayout>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                app:cardBackgroundColor="@color/yellow"
                                app:cardCornerRadius="27dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/white"
                                app:strokeWidth="2dp">

                                <TextView
                                    android:id="@+id/percentBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/montserrat_extrabold"
                                    android:textColor="@color/ink"
                                    android:textSize="14sp"
                                    tools:text="60%" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/overallProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="14dp"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_yellow"
                            tools:progress="60" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/lessonsDone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/montserrat_semibold"
                                android:textColor="@color/soft_muted"
                                android:textSize="10sp"
                                tools:text="2 of 4 core modules" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_semibold"
                                android:text="@string/home_keep_going"
                                android:textColor="@color/soft_muted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- ปุ่ม Continue Learning -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/continueButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/yellow"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_extrabold"
                                    android:text="@string/home_continue"
                                    android:textColor="@color/ink"
                                    android:textSize="13sp" />

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="6dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_arrow"
                                    app:tint="@color/ink" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Core Modules Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_syllabus_eyebrow"
                            android:textColor="@color/purple_deep" />

                        <TextView
                            style="@style/Text.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_syllabus_title" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/home_syllabus_subtitle" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="@color/ink"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="0.5"
                        android:text="★"
                        android:textColor="@color/yellow"
                        android:textSize="22sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Lesson List (4 Core Modules) -->
                <LinearLayout
                    android:id="@+id/lessonList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- ===== Bonus Tracks Section ===== -->
                <TextView
                    style="@style/Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/home_bonus_eyebrow"
                    android:textColor="@color/purple_deep" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_bonus_title" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="14dp"
                    android:text="@string/home_bonus_subtitle" />

                <!-- Bonus Card 1: Build a Mini-Game (Yellow) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bonusGameCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/yellow"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ink"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:cardBackgroundColor="@color/ink"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_play"
                                app:tint="@color/purple" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_extrabold"
                                android:letterSpacing="0.1"
                                android:text="WEEKS 8-10"
                                android:textColor="@color/ink"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_extrabold"
                                android:text="Build a Mini-Game"
                                android:textColor="@color/ink"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="@color/ink"
                                android:textSize="11sp"
                                android:text="Explore Pygame Zero and turn Python ideas into a playable game." />

                            <!-- Action button chip -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="@color/yellow_pale"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="Open code lab >"
                                    android:textColor="@color/ink"
                                    android:textSize="10sp" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bonus Card 2: Advanced Python Preview (Purple) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bonusAdvancedCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/purple"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ink"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:cardBackgroundColor="@color/yellow_pale"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/ink"
                            app:strokeWidth="1.5dp">

                            <TextView
                                style="@style/Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="&lt;/&gt;"
                                android:textColor="@color/ink"
                                android:textSize="18sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_extrabold"
                                android:letterSpacing="0.1"
                                android:text="WEEKS 11-14"
                                android:textColor="@color/ink"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_extrabold"
                                android:text="Advanced Python Preview"
                                android:textColor="@color/ink"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="@color/ink"
                                android:textSize="11sp"
                                android:text="Take a peek at exceptions, file handling, and OOP." />

                            <!-- Chips -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_chip_ink"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:fontFamily="@font/montserrat_extrabold"
                                    android:text="Exceptions"
                                    android:textColor="@color/white"
                                    android:textSize="9sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_chip_ink"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:fontFamily="@font/montserrat_extrabold"
                                    android:text="Files"
                                    android:textColor="@color/white"
                                    android:textSize="9sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_chip_ink"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp"
                                    android:fontFamily="@font/montserrat_extrabold"
                                    android:text="OOP"
                                    android:textColor="@color/white"
                                    android:textSize="9sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Study tools Header -->
                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="13dp"
                    android:text="@string/home_tools_title" />

                <!-- 2x2 Grid -->
                <GridLayout
                    android:id="@+id/quickGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.pyschool.app.ui.common.BottomNavView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
