<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple">

    <!-- วงกลมตกแต่งมุมซ้ายบน / ขวาล่าง -->
    <View
        android:layout_width="220dp"
        android:layout_height="150dp"
        android:layout_marginStart="-110dp"
        android:layout_marginTop="-55dp"
        android:background="@drawable/bg_splash_circle"
        android:rotation="-30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="220dp"
        android:layout_height="150dp"
        android:layout_marginEnd="-120dp"
        android:layout_marginBottom="-60dp"
        android:background="@drawable/bg_splash_circle"
        android:rotation="-30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ดาว -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rotation="15"
        android:shadowColor="@color/ink"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="0.5"
        android:text="★"
        android:textColor="@color/yellow"
        android:textSize="33sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.82"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.22"
        tools:ignore="HardcodedText" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rotation="-10"
        android:shadowColor="@color/ink"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="0.5"
        android:text="★"
        android:textColor="@color/yellow"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.73"
        tools:ignore="HardcodedText" />

    <!-- โลโก้ logo_see -->
    <FrameLayout
        android:id="@+id/logo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintBottom_toTopOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_see"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/montserrat_extrabold"
        android:letterSpacing="-0.05"
        android:text="@string/app_name"
        android:textColor="@color/ink"
        android:textSize="40sp"
        app:layout_constraintBottom_toTopOf="@id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/montserrat_extrabold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:text="@string/tagline_two_lines"
        android:textColor="@color/ink"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <!-- จุดโหลด 3 จุด (animate ใน SplashActivity) -->
    <LinearLayout
        android:id="@+id/loadingDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot_ink" />
        <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="8dp" android:background="@drawable/bg_dot_ink" />
        <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="8dp" android:background="@drawable/bg_dot_ink" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
