<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/view_page_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title Header -->
            <TextView
                style="@style/Text.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTERACTIVE GAME LAB"
                android:textColor="@color/purple_deep" />

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Catch the Python Star" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="16dp"
                android:text="Press arrow buttons to move Py and trigger collision detection." />

            <!-- Game Sandbox Canvas Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ink"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ink"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Canvas Top Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/scoreText"
                            style="@style/Text.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCORE: 00"
                            android:textColor="@color/yellow"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_purple"
                            android:fontFamily="@font/montserrat_extrabold"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="Pygame Zero"
                            android:textColor="@color/white"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Game Stage Canvas Area -->
                    <FrameLayout
                        android:id="@+id/gameStage"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_dashed_box"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- Target Star -->
                        <TextView
                            android:id="@+id/starView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="32dp"
                            android:shadowColor="@color/yellow"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="8"
                            android:text="★"
                            android:textColor="@color/yellow"
                            android:textSize="32sp" />

                        <!-- Player Py Circle -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/playerView"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="20dp"
                            app:cardBackgroundColor="@color/yellow"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/white"
                            app:strokeWidth="2dp">

                            <TextView
                                style="@style/Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Py"
                                android:textColor="@color/ink"
                                android:textSize="14sp" />
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <!-- Arrow Controls Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Left Arrow Button -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnLeft"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/purple"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/montserrat_extrabold"
                                android:text="&lt;"
                                android:textColor="@color/white"
                                android:textSize="20sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Right Arrow Button -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnRight"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/yellow"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/montserrat_extrabold"
                                android:text="&gt;"
                                android:textColor="@color/ink"
                                android:textSize="20sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Reset Button -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnResetGame"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/purple_pale"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/montserrat_bold"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="Reset"
                                android:textColor="@color/ink"
                                android:textSize="11sp" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mission / Collision Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/missionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/missionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:text="GAME MISSION"
                        android:textColor="@color/purple_deep"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/missionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="Use the &gt; button to move Py toward the star. Watch what happens when collision detection condition evaluates to True!"
                        android:textColor="@color/ink"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Code Block Section -->
            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="Python Code Logic" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ink"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/codeText"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.3"
                    android:padding="16dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="def update():\n    if keyboard.right:\n        player.x += 5\n    if player.colliderect(star):\n        score = 1" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Interactive Lesson Tabs (01-04) -->
            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="Interactive Concepts" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Tab Explanation Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tabConceptTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:textColor="@color/purple_deep"
                        android:textSize="12sp"
                        tools:text="01 Read keyboard input" />

                    <TextView
                        android:id="@+id/tabConceptDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        tools:text="Pygame Zero checks keyboard input during each update loop." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
